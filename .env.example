# Postgres connection string. Works with any standard Postgres host
# (Neon, Vercel Postgres, Supabase, Railway, a local `postgres` instance, ...).
DATABASE_URL="postgresql://user:password@localhost:5432/grillme"

# Random secret used to sign staff session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-string"
